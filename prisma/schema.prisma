generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  foto         String?
  bio          String?
  dataCadastro DateTime @default(now())

  posts Post[]
}

model Musica {
  id        Int      @id @default(autoincrement())
  spotifyId String?  @unique
  titulo      String
  artista     String
  genero      String
  duracaoSegundos Int
  capa             String?
  spotifyUrl       String?

  posts Post[]
}

model Post {
   id        Int      @id @default(autoincrement())
  usuarioId Int
  musicaId  Int
  nota      Float
  texto     String
  dataCriacao DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  musica  Musica  @relation(fields: [musicaId], references: [id])
}