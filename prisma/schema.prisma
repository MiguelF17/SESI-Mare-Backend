generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  foto         String?
  bio          String?
  dataCadastro DateTime @default(now())

  posts Post[]
  curtidas Curtida[]
  comentarios Comentario[]
  seguindo  Seguidor[] @relation("seguindo")
seguidores Seguidor[] @relation("seguidores")
salvamentos Salvamento[]
}

model Musica {
  id              Int     @id @default(autoincrement())
  spotifyId       String? @unique
  titulo          String
  artistaId       Int
  genero          String
  duracaoSegundos Int
  capa            String?
  spotifyUrl      String?

  artista     Artista @relation(fields: [artistaId], references: [id])
  posts       Post[]
  salvamentos Salvamento[]
}

model Artista {
  id    Int     @id @default(autoincrement())
  nome  String
  fotoURL  String?

  musicas Musica[]
}

model Post {
   id        Int      @id @default(autoincrement())
  usuarioId Int
  musicaId  Int
  nota      Float
  texto     String
  dataCriacao DateTime @default(now())

  curtidas Curtida[]
  comentarios Comentario[]

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  musica  Musica  @relation(fields: [musicaId], references: [id])

  @@unique([usuarioId, musicaId])
}

model Curtida {
  usuarioId   Int
  postId      Int
  dataCriacao DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([usuarioId, postId])
}

model Comentario {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  postId      Int
  texto       String
  dataCriacao DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Seguidor {
  seguidorId Int
  seguidoId  Int
  dataCriacao DateTime @default(now())

  seguidor Usuario @relation("seguindo", fields: [seguidorId], references: [id])
  seguido  Usuario @relation("seguidores", fields: [seguidoId], references: [id])

  @@id([seguidorId, seguidoId])
}

model Salvamento {
  usuarioId   Int
  musicaId    Int
  dataCriacao DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  musica  Musica  @relation(fields: [musicaId], references: [id])

  @@id([usuarioId, musicaId])
}